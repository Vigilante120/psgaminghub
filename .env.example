# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your site URL (used for login email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# UPI details shown on the payment page
NEXT_PUBLIC_UPI_ID=yourname@okaxis
NEXT_PUBLIC_UPI_NAME=PS GAMING HUB

# Your WhatsApp number with country code, digits only (support button)
NEXT_PUBLIC_WHATSAPP=919999999999

# Order emails (optional): get a free API key at resend.com.
# With Resend's test sender, ORDER_ALERT_EMAIL must be the email you signed up to Resend with.
RESEND_API_KEY=
ORDER_ALERT_EMAIL=you@example.com
# ORDER_EMAIL_FROM=PS GAMING HUB <orders@yourdomain.com>
